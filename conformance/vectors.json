{
  "protocol": "kin/0.1",
  "canonicalisation": {
    "encoding": "utf-8",
    "sort_keys": true,
    "separators": [",", ":"]
  },
  "vectors": [
    {
      "id": "hello-canonical-sha256",
      "input": {
        "protocol": "kin/0.1",
        "type": "hello",
        "node_id": "demo-node",
        "capabilities": ["cpu", "private-code"]
      },
      "expected_canonical": "{\"capabilities\":[\"cpu\",\"private-code\"],\"node_id\":\"demo-node\",\"protocol\":\"kin/0.1\",\"type\":\"hello\"}",
      "expected_sha256": "bcf283af485c978b421460b8e8f7cd9c3101a45bf33b9ce528b8c61887da181d"
    },
    {
      "id": "update-canonical-sha256",
      "input": {
        "protocol": "kin/0.1",
        "type": "update",
        "base_checkpoint": "sha256:genesis",
        "job_id": "job-0001",
        "node_id": "demo-node",
        "sample_count": 12,
        "delta_digest": "sha256:example"
      },
      "expected_canonical": "{\"base_checkpoint\":\"sha256:genesis\",\"delta_digest\":\"sha256:example\",\"job_id\":\"job-0001\",\"node_id\":\"demo-node\",\"protocol\":\"kin/0.1\",\"sample_count\":12,\"type\":\"update\"}",
      "expected_sha256": "5b7852af5efc01eea038bffc71b9c8875c0daebf75f2aaf2e853dea4dbfd86aa"
    },
    {
      "id": "reject-wrong-protocol",
      "input": {"protocol": "kin/9.9", "type": "hello", "node_id": "demo-node", "capabilities": []},
      "expected_valid": false,
      "expected_reason": "unsupported protocol"
    },
    {
      "id": "reject-code-payload",
      "input": {"protocol": "kin/0.1", "type": "hello", "node_id": "demo-node", "capabilities": [], "source_code": "print('must not leave device')"},
      "expected_valid": false,
      "expected_reason": "generated code in network message"
    },
    {
      "id": "reject-unfunded-price-quote",
      "input": {"protocol": "kin/0.1", "type": "price_quote", "job_id": "job-0002", "base_checkpoint": "sha256:genesis", "pricing_version": "0.1-fixed", "currency": "ZAR", "max_payout": "50.00"},
      "expected_valid": false,
      "expected_reason": "missing funding commitment"
    }
  ]
}
